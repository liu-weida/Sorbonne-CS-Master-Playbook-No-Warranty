<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--c6 -->
  <xs:key name="villeKey">
    <xs:selector xpath="./ville"/>
    <xs:field xpath="@nom"/>
  </xs:key>


  <xs:keyref name="villeKeyRef" refer="villeKey">
    <xs:selector xpath="./restaurant"/>
    <xs:field xpath="@ville"/>
  </xs:keyref>
  
<xs:element name="base">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="restaurant" type="restaurantType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="ville" type="villeType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

</xs:element>

<xs:complexType name="restaurantType">
  <xs:sequence>
    <xs:element name="fermeture" type="xs:string" minOccurs='0'/>
    <xs:element name="menu" type="menuType" minOccurs='2' maxOccurs="unbounded"/>
  </xs:sequence>
  <xs:attribute name="nom" type="xs:string" use="required"/>
  <xs:attribute name="etoile" type="xs:integer" use="required" minOccurs='0' maxOccurs="3"/>
  <xs:attribute name="ville" type="xs:string" use="required"/>
</xs:complexType>
   
<xs:complexType name="menuType">
  <xs:attribute name="nom" type="xs:string" use="required"/>
  <xs:attribute name="prix" type="xs:integer" use="required"/>
</xs:complexType>

<xs:complexType name="villeType">
  <xs:sequence>
    <xs:element name="plusBeauMonument" minOccurs='0' maxOccurs='1'>
        <xs:complexType>
          <xs:attribute name="nom" type="xs:string" use="required"/>
          <xs:attribute name="tarif" type="xs:integer" use="required"/>
        </xs:complexType>
    </xs:element>
  </xs:sequence>
    <xs:attribute name="nom" type="xs:string" use="required"/>
    <xs:attribute name="departement" type="xs:string" use="required"/>
</xs:complexType>

</xs:schema>